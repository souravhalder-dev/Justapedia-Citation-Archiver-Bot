# ==============================================================================
# Justapedia Wayback Machine Citation Archiver Bot - Environment Variables
# ==============================================================================

# MediaWiki API Configuration
JUSTAPEDIA_API_URL=https://justapedia.org/api.php
JUSTAPEDIA_BASE_URL=https://justapedia.org

# Bot Account Credentials (Leave empty for Read-Only / Dry-Run mode)
JUSTAPEDIA_BOT_USERNAME=
JUSTAPEDIA_BOT_PASSWORD=

# Default Edit Summary
JUSTAPEDIA_EDIT_SUMMARY=Bot: Added Wayback Machine archive information to citations

# Internet Archive Endpoints
WAYBACK_AVAILABILITY_URL=https://archive.org/wayback/available
WAYBACK_CDX_URL=https://web.archive.org/cdx/search/cdx

# SQLite Database Storage
DB_PATH=justapedia_archiver.db

# User Agent for MediaWiki and Wayback Requests
BOT_USER_AGENT=JustapediaWaybackBot/1.0 (+https://justapedia.org/wiki/Justapedia:Bots; mailto:admin@justapedia.org)

# Timeouts and Retries
BOT_REQUEST_TIMEOUT=15
BOT_URL_CHECK_TIMEOUT=10
BOT_MAX_RETRIES=3
BOT_BACKOFF_FACTOR=1.5

# Rate Limits (in seconds)
BOT_EDIT_RATE_LIMIT=2.0
BOT_URL_CHECK_RATE_LIMIT=0.2

# Cache Expiration (in days)
BOT_URL_CACHE_TTL_DAYS=14
BOT_SNAPSHOT_CACHE_TTL_DAYS=30
